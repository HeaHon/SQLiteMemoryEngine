<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>RocksDbNative</id>
    <version>6.2.2</version>
    <title>RocksDbNative</title>
    <authors>Warren Falk</authors>
    <owners>Warren Falk</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="expression">BSD-2-Clause</license>
    <licenseUrl>https://licenses.nuget.org/BSD-2-Clause</licenseUrl>
    <projectUrl>https://github.com/warrenfalk/rocksdb-sharp</projectUrl>
    <iconUrl>http://rocksdb.org/static/logo.svg</iconUrl>
    <description>Native RocksDb Binaries (Install RocksDbSharp package for managed wrapper)</description>
    <releaseNotes>Native RocksDb Binaries (Install RocksDbSharp package for managed wraper)</releaseNotes>
    <copyright>Copyright 2016</copyright>
    <tags>rocksdb leveldb embedded database</tags>
    <repository url="https://github.com/warrenfalk/rocksdb-sharp.git" />
    <dependencies>
      <group targetFramework=".NETFramework4.0" />
      <group targetFramework=".NETFramework4.5" />
      <group targetFramework=".NETStandard1.6">
        <dependency id="NETStandard.Library" version="1.6.1" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>